#!/usr/bin/env python3
# Widget Miku — cycling Miku kaomoji as its own small widget.
import os
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.local/bin"))
from widget_lib import mkwin, one_instance

pidf = one_instance("miku")

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

win, box = mkwin("miku", """
#mword { font-size: 17px; }
""")

lbl = Gtk.Label(label="")
lbl.set_name("mword")
box.pack_start(lbl, True, True, 0)


def fetch():
    r = subprocess.run(["/home/abo3aisha/.local/bin/miku-kaomoji"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else "(・ω・)"


def tick():
    lbl.set_text(fetch())
    return True


def on_destroy(*a):
    try:
        os.unlink(pidf)
    except OSError:
        pass
    Gtk.main_quit()


tick()
GLib.timeout_add(2400, tick)
win.connect("destroy", on_destroy)
win.show_all()
Gtk.main()
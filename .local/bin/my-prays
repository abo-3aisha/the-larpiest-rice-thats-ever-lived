_PT = None


def prayer_mod():
    global _PT
    if _PT is None:
        import runpy
        _PT = runpy.run_path(PT_BIN)
    return _PT


def accent():
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import widget_lib
        return widget_lib.accent()
    except Exception:
        return "d7cc00"


def load_cfg():
    try:
        return prayer_mod()["read_cfg"]()
    except Exception:
        return {"lat": 33.514, "lon": 36.277, "alarm": True}


ALL_KEYS = ("LAT", "LON", "CITY", "ALARM", "FAJR_ENABLED", "DUHA_ENABLED",
            "DHUHR_ENABLED", "ASR_ENABLED", "MAGHRIB_ENABLED", "ISHA_ENABLED")


def write_keys(updates):
    text = ""
    if os.path.isfile(CONF):
        with open(CONF, errors="replace") as fh:
            text = fh.read()
    if not text:
        text = "# Prayer times config\n"
    for k, v in updates.items():
        k = k.upper()
        pattern = r"(?m)^%s=.*$" % k
        if re.search(pattern, text):
            text = re.sub(pattern, "%s=%s" % (k, v), text)
        else:
            text = text.rstrip() + "\n%s=%s\n" % (k, v)
    with open(CONF, "w") as fh:
        fh.write(text)


def load_hadiths():
    try:
        with open(HADITHS, errors="replace") as fh:
            data = json.load(fh)
        return data if isinstance(data, list) else []
    except Exception:
        return []


class MyPrays(Gtk.Window):
    def __init__(self):
        super().__init__(title="My Prays")
        self.set_default_size(600, 820)
        self.nxt = None
        self.evs = []

        css = (
            "window { background-color: #141419; color: #f1f1f3; }\n"
            "frame { border-color: #2c2c34; }\n"
            "frame > border { border-radius: 10px; }\n"
            "label { color: #f1f1f3; }\n"
            "switch { font-size: 0; }\n"
        )
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), provider, 800)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_start(18)
        box.set_margin_end(18)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        scroller.add(box)
        self.add(scroller)

        head = Gtk.Label(xalign=0.0)
        head.set_markup(
            "<span size='xx-large' weight='bold'>My Prays</span>\n"
            "<span size='small' color='#8a8a93'>Prayer times · adhan alarm · hadith of the day</span>")
        box.pack_start(head, False, False, 0)

        box.pack_start(self.build_location(), False, False, 0)
        box.pack_start(self.build_timezone(), False, False, 0)
        box.pack_start(self.build_times(), False, False, 0)
        box.pack_start(self.build_alarm(), False, False, 0)
        box.pack_start(self.build_hadith(), False, False, 0)

        foot = Gtk.Label(xalign=0.0, wrap=True)
        foot.set_markup(
            "<span size='small' color='#8a8a93'>All times are computed "
            "offline from these coordinates for your system clock. Only "
            "\"Detect\" uses your IP (same guarded rules as prayer-locate).</span>")
        box.pack_start(foot, False, False, 0)

        self.load_state()
        self.pick_hadith()
        self.refresh_times()
        GLib.timeout_add(1000, self.tick_countdown)
        GLib.timeout_add(30000, self.refresh_times)
        self.connect("destroy", Gtk.main_quit)

    def build_location(self):
        frm = Gtk.Frame(label=" Location ")
        grid = Gtk.Grid(column_spacing=8, row_spacing=6)
        grid.set_margin_start(12)
        grid.set_margin_end(12)
        grid.set_margin_top(10)
        grid.set_margin_bottom(12)

        lbl_c = Gtk.Label(label="Country", xalign=0.0)
        self.country_combo = Gtk.ComboBoxText()
        for country, _ in COUNTRIES:
            self.country_combo.append_text(country)
        self.country_combo.connect("changed", self.on_country_changed)

        lbl_i = Gtk.Label(label="City", xalign=0.0)
        self.city_combo = Gtk.ComboBoxText()
        self.city_combo.connect("changed", self.on_city_changed)

        lbl_la = Gtk.Label(label="Latitude", xalign=0.0)
        self.lat_spin = Gtk.SpinButton.new_with_range(-90.0, 90.0, 0.0001)
        self.lat_spin.set_digits(5)
        self.lat_spin.set_width_chars(10)
        lbl_lo = Gtk.Label(label="Longitude", xalign=0.0)
        self.lon_spin = Gtk.SpinButton.new_with_range(-180.0, 180.0, 0.0001)
        self.lon_spin.set_digits(5)
        self.lon_spin.set_width_chars(10)

        self.detect_lbl = Gtk.Label(xalign=0.0, wrap=True)
        self.detect_lbl.set_markup("<span size='small' color='#8a8a93'></span>")

        row_btns = Gtk.Box(spacing=8)
        detect = Gtk.Button(label="Detect")
        detect.connect("clicked", self.on_detect)
        save = Gtk.Button(label="Save location")
        save.connect("clicked", self.on_save_location)
        row_btns.pack_start(detect, False, False, 0)
        row_btns.pack_start(save, False, False, 0)

        grid.attach(lbl_c, 0, 0, 1, 1)
        grid.attach(self.country_combo, 1, 0, 2, 1)
        grid.attach(lbl_i, 0, 1, 1, 1)
        grid.attach(self.city_combo, 1, 1, 2, 1)
        grid.attach(lbl_la, 0, 2, 1, 1)
        grid.attach(self.lat_spin, 1, 2, 1, 1)
        grid.attach(lbl_lo, 2, 2, 1, 1)
        grid.attach(self.lon_spin, 3, 2, 1, 1)
        grid.attach(row_btns, 0, 3, 2, 1)
        grid.attach(self.detect_lbl, 0, 4, 4, 1)

        frm.add(grid)
        return frm

    def build_timezone(self):
        frm = Gtk.Frame(label=" Clock / Timezone ")
        self.tz_lbl = Gtk.Label(xalign=0.0, wrap=True)
        self.tz_lbl.set_margin_start(12)
        self.tz_lbl.set_margin_end(12)
        self.tz_lbl.set_margin_top(10)
        self.tz_lbl.set_margin_bottom(12)
        frm.add(self.tz_lbl)
        return frm

    def build_times(self):
        frm = Gtk.Frame(label=" Today's times ")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        grid = Gtk.Grid(column_spacing=16, row_spacing=2)
        self.time_lbl = {}
        self.time_txt = {}
        for i, n in enumerate(NAMES):
            l = Gtk.Label(xalign=0.0)
            l.set_markup(n)
            t = Gtk.Label(xalign=1.0)
            self.time_lbl[n] = l
            self.time_txt[n] = t
            grid.attach(l, 0, i, 1, 1)
            grid.attach(t, 1, i, 1, 1)
        self.next_lbl = Gtk.Label(xalign=0.0)
        v.pack_start(grid, False, False, 0)
        v.pack_start(self.next_lbl, False, False, 0)
        v.set_margin_start(12)
        v.set_margin_end(12)
        v.set_margin_top(10)
        v.set_margin_bottom(12)
        frm.add(v)
        return frm

    def build_alarm(self):
        frm = Gtk.Frame(label=" Adhan alarm ")
        grid = Gtk.Grid(column_spacing=12, row_spacing=6)
        grid.set_margin_start(12)
        grid.set_margin_end(12)
        grid.set_margin_top(10)
        grid.set_margin_bottom(12)

        m = Gtk.Label(label="Master alarm (all prayers)", xalign=0.0)
        self.master = Gtk.Switch()
        grid.attach(m, 0, 0, 1, 1)
        grid.attach(self.master, 1, 0, 1, 1)

        self.sw = {}
        for i, n in enumerate(NAMES, start=1):
            lbl = Gtk.Label(label=n + (" (optional)" if n == "Duha" else ""), xalign=0.0)
            sw = Gtk.Switch()
            self.sw[n] = sw
            grid.attach(lbl, 0, i, 1, 1)
            grid.attach(sw, 1, i, 1, 1)

        self.master.connect("notify::active", self.save_alarms)
        for n in NAMES:
            self.sw[n].connect("notify::active", self.save_alarms)
        frm.add(grid)
        return frm

    def build_hadith(self):
        frm = Gtk.Frame(label=" Hadith of the day ")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.hadith_lbl = Gtk.Label(xalign=0.0, wrap=True)
        self.hadith_lbl.set_line_wrap(True)
        self.hadith_lbl.set_margin_start(12)
        self.hadith_lbl.set_margin_end(12)
        self.hadith_lbl.set_margin_top(10)
        another = Gtk.Button(label="Another hadith")
        another.connect("clicked", lambda *a: self.pick_hadith())
        v.pack_start(self.hadith_lbl, False, False, 0)
        v.pack_start(another, False, False, 0)
        v.set_margin_bottom(12)
        frm.add(v)
        return frm

    def on_country_changed(self, _w):
        ci = self.country_combo.get_active()
        if ci < 0:
            return
        self.city_combo.handler_block_by_func(self.on_city_changed)
        self.city_combo.remove_all()
        for city, _, _ in COUNTRIES[ci][1]:
            self.city_combo.append_text(city)
        self.city_combo.set_active(0)
        self.city_combo.handler_unblock_by_func(self.on_city_changed)
        self.on_city_changed(None)

    def on_city_changed(self, _w):
        ci = self.country_combo.get_active()
        if ci < 0:
            return
        ni = self.city_combo.get_active()
        if ni < 0:
            return
        _, lat, lon = COUNTRIES[ci][1][ni]
        self.lat_spin.set_value(lat)
        self.lon_spin.set_value(lon)

    def on_save_location(self, _b):
        lat = self.lat_spin.get_value()
        lon = self.lon_spin.get_value()
        city = "Custom"
        ci = self.country_combo.get_active()
        ni = self.city_combo.get_active()
        if ci >= 0 and ni >= 0:
            cname, clat, clon = COUNTRIES[ci][1][ni]
            if abs(clat - lat) < 0.01 and abs(clon - lon) < 0.01:
                city = cname
        write_keys({"LAT": "%.5f" % lat, "LON": "%.5f" % lon, "CITY": city})
        self.detect_lbl.set_markup(
            "<span size='small' color='#9ede8a'>Saved: %s (%.4f, %.4f). "
            "The running daemon picks it up at the next event.</span>"
            % (city, lat, lon))
        self.refresh_times()

    def on_detect(self, _b):
        try:
            out = subprocess.run([LOCATE_BIN, "--force"], capture_output=True,
                                 text=True, timeout=25)
            line = (out.stdout or out.stderr or "").strip().splitlines()
            msg = line[-1] if line else "detect failed"
        except Exception as exc:
            msg = "detect failed: %s" % exc
        self.detect_lbl.set_markup("<span size='small' color='%s'>%s</span>"
                                   % ("#e5c07b" if "skipped" in msg
                                      else "#9ede8a", GLib.markup_escape_text(msg)))
        cfg = load_cfg()
        self.lat_spin.set_value(cfg.get("lat", 33.514))
        self.lon_spin.set_value(cfg.get("lon", 36.277))
        self.refresh_times()

    def save_alarms(self, _s=None, _p=None):
        updates = {"ALARM": 1 if self.master.get_active() else 0}
        for n in NAMES:
            updates[n.upper() + "_ENABLED"] = 1 if self.sw[n].get_active() else 0
        write_keys(updates)

    def load_state(self):
        cfg = load_cfg()
        self.lat_spin.set_value(cfg.get("lat", 33.514))
        self.lon_spin.set_value(cfg.get("lon", 36.277))

        self.master.handler_block_by_func(self.save_alarms)
        self.master.set_active(bool(cfg.get("alarm", True)))
        self.master.handler_unblock_by_func(self.save_alarms)
        for n in NAMES:
            key = n.lower() + "_enabled"
            sw = self.sw[n]
            sw.handler_block_by_func(self.save_alarms)
            sw.set_active(bool(cfg.get(key, True)))
            sw.handler_unblock_by_func(self.save_alarms)

        city = str(cfg.get("city", ""))
        best = None
        for ci, (country, cities) in enumerate(COUNTRIES):
            for ni, (cname, clat, clon) in enumerate(cities):
                if cname.lower() in city.lower() or city.lower() in cname.lower():
                    best = (ci, ni)
                    break
            if best:
                break
        if best is None:
            clat, clon = cfg.get("lat", 33.514), cfg.get("lon", 36.277)
            for ci, (country, cities) in enumerate(COUNTRIES):
                for ni, (cname, clat2, clon2) in enumerate(cities):
                    if (abs(clat - clat2) + abs(clon - clon2)) < 0.05:
                        best = (ci, ni)
                        break
                if best:
                    break
        if best:
            self.country_combo.set_active(best[0])
            self.city_combo.set_active(best[1])

        now = datetime.now().astimezone()
        tz = getattr(now.tzinfo, "key", str(now.tzinfo))
        off = now.utcoffset().total_seconds() / 3600
        sign = "+" if off >= 0 else "-"
        self.tz_lbl.set_markup(
            "<b>%s</b> (%s%02d:%02d)<br/>"
            "<span size='small' color='#8a8a93'>The adhan follows your "
            "system clock — make sure this machine shows the time where you "
            "are.</span>"
            % (tz, sign, int(abs(off)), int((abs(off) % 1) * 60)))

    def compute_now(self):
        cfg = load_cfg()
        now = datetime.now()
        evs = prayer_mod()["events_for"](now.date(), cfg)
        self.evs = evs
        self.nxt = None
        for n, t in evs:
            if t > now:
                self.nxt = (n, t)
                return
        evs = prayer_mod()["events_for"](now.date() + timedelta(days=1), cfg)
        self.evs = evs
        self.nxt = evs[0]

    def refresh_times(self, *_a):
        try:
            self.compute_now()
        except Exception:
            return True
        accent_color = accent()
        for n, t in self.evs:
            lbl = self.time_lbl.get(n)
            txt = self.time_txt.get(n)
            if not lbl or not txt:
                continue
            is_next = self.nxt and n == self.nxt[0]
            if is_next:
                lbl.set_markup("<b><span foreground='#%s'>%s</span></b>"
                               % (accent_color, n))
                txt.set_markup("<b><span foreground='#%s'>%s</span></b>"
                               % (accent_color, t.strftime("%H:%M")))
            else:
                lbl.set_markup(n)
                txt.set_text(t.strftime("%H:%M"))
        return True

    def tick_countdown(self):
        if self.nxt:
            n, t = self.nxt
            d = (t - datetime.now()).total_seconds()
            if d < 0:
                self.refresh_times()
                return True
            h = int(d // 3600)
            m = int((d % 3600) // 60)
            s = int(d % 60)
            self.next_lbl.set_markup(
                "<b>Next</b>: %s in <b>%d:%02d:%02d</b>"
                % (n, h, m, s))
        else:
            self.next_lbl.set_text("")
        return True

    def pick_hadith(self, *_a):
        hadiths = load_hadiths()
        if not hadiths:
            self.hadith_lbl.set_markup(
                "<i>No hadiths found — add ~/.config/prayer/hadiths.json</i>")
            return
        h = random.choice(hadiths)
        ar = GLib.markup_escape_text(str(h.get("ar", "")))
        en = GLib.markup_escape_text(str(h.get("en", "")))
        san = GLib.markup_escape_text(str(h.get("sanad", "")))
        self.hadith_lbl.set_markup(
            "<span size='large'>%s</span>\n\n%s\n\n"
            "<span size='small' color='#8a8a93'>%s</span>" % (ar, en, san))


if __name__ == "__main__":
    win = MyPrays()
    win.show_all()
    Gtk.main()
#!/usr/bin/env python3
"""My Prays — prayer settings, adhan-master + per-prayer alarm switches, and a
random authentic hadith every time the window opens. Launched from SUPER+S
(Control Center). UI chrome is English; hadith text is shown Arabic + English
with the isnaad in a smaller line. All math is offline; only the optional
"Detect" button touches the internet (same guarded logic as prayer-locate)."""

import json
import os
import random
import re
import subprocess
from datetime import datetime, timedelta

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk


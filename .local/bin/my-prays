HADITHS = os.path.expanduser("~/.config/prayer/hadiths.json")
PT_BIN = os.path.expanduser("~/.local/bin/prayer-times")
LOCATE_BIN = os.path.expanduser("~/.local/bin/prayer-locate")

NAMES = tuple("Fajr Duha Dhuhr Asr Maghrib Isha".split())


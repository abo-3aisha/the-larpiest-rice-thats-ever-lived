#!/usr/bin/env python3
# Widget Prayer — which prayer we are currently in + countdown to the next one.
import os
import i18n
import subprocess
import sys
import time

sys.path.insert(0, os.path.expanduser("~/.local/bin"))
from widget_lib import mkwin, one_instance

pidf = one_instance("prayer")

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

win, box = mkwin("prayer", """
#pnow { font-size: 17px; font-weight: bold; }
#pnext { font-size: 12px; color: rgba(241,241,243,0.72); }
""")

# prayer-times prints English event names on stdout; map them to the active
# language here rather than changing its output contract (my-prays parses it).
PRAYER_KEYS = {
    "Fajr": "PRAY_FAJR", "Duha": "PRAY_DUHA", "Dhuhr": "PRAY_DHUHR",
    "Asr": "PRAY_ASR", "Maghrib": "PRAY_MAGHRIB", "Isha": "PRAY_ISHA",
}


def L(event):
    return i18n.t(PRAYER_KEYS[event]) if event in PRAYER_KEYS else event


now_lbl = Gtk.Label(label="%s: ..." % i18n.t("PRAY_NOW"))
now_lbl.set_name("pnow")
next_lbl = Gtk.Label(label="%s: ..." % i18n.t("PRAY_NEXT"))
next_lbl.set_name("pnext")
box.pack_start(now_lbl, True, True, 0)
box.pack_start(next_lbl, False, False, 0)


def fetch_now():
    r = subprocess.run(["/home/abo3aisha/.local/bin/prayer-times", "--now"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return "", ""
    first = r.stdout.strip().splitlines()
    cur = next_str = ""
    for ln in first:
        if ln.startswith("Now:"):
            cur = ln.replace("Now: ", "").split("(")[0].strip()
        elif ln.startswith("Next:"):
            next_str = ln.replace("Next: ", "").strip()
    return cur, next_str


def parse_time(s):
    try:
        h, m = s.strip().split(":")
        return int(h), int(m)
    except Exception:
        return None


def countdown(h, m):
    now = time.localtime()
    target = time.mktime((now.tm_year, now.tm_mon, now.tm_mday, h, m, 0,
                          now.tm_wday, now.tm_yday, now.tm_isdst))
    if target <= time.time() - 60:
        target += 86400
    secs = max(0, int(target - time.time()))
    hh, mm = secs // 3600, (secs % 3600) // 60
    if hh > 0:
        return "%dh %02dm" % (hh, mm)
    return "%dm" % max(0, mm)


def tick():
    cur, nxt = fetch_now()
    if cur:
        now_lbl.set_text("%s: %s" % (i18n.t("PRAY_NOW"), L(cur)))
    if nxt:
        # nxt looks like "Fajr at 04:55"
        parts = nxt.split("at ")
        name = parts[0].strip()
        hm = parts[1].strip() if len(parts) > 1 else ""
        t = parse_time(hm)
        if t:
            next_lbl.set_text("%s: %s in %s" % (i18n.t("PRAY_NEXT"), L(name), countdown(*t)))
        else:
            next_lbl.set_text("%s: %s" % (i18n.t("PRAY_NEXT"), L(name)))
    return True


def on_destroy(*a):
    try:
        os.unlink(pidf)
    except OSError:
        pass
    Gtk.main_quit()


tick()
GLib.timeout_add(30000, tick)
win.connect("destroy", on_destroy)
win.show_all()
Gtk.main()
#!/usr/bin/env python3
# Widget Clock — floating glass clock (position/workspace managed by widgets-apply).
import os
import sys
import time
import i18n

sys.path.insert(0, os.path.expanduser("~/.local/bin"))
from widget_lib import mkwin, one_instance

pidf = one_instance("clock")

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

win, box = mkwin("clock", """
#wtime { font-size: 34px; font-weight: bold; }
#wdate { font-size: 12px; color: rgba(241,241,243,0.72); }
""")

t = Gtk.Label()
t.set_name("wtime")
d = Gtk.Label()
d.set_name("wdate")
box.pack_start(t, True, True, 0)
box.pack_start(d, False, False, 0)


def tick():
    now = i18n.render(i18n._conf_val("CLOCK") or "%H:%M")
    today = i18n.render("%A %d %B")
    if t.get_text() != now:
        t.set_text(now)
    d.set_text(today)
    return True


def on_destroy(*a):
    try:
        os.unlink(pidf)
    except OSError:
        pass
    Gtk.main_quit()


tick()
GLib.timeout_add(1000, tick)
win.connect("destroy", on_destroy)
win.show_all()
Gtk.main()
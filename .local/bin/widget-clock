#!/usr/bin/env python3
# Widget Clock — floating glass clock with smooth text transitions:
# the time ROLLS (slide up/down) every minute, the date CROSSFADES when
# day/month/year change. Position/workspace managed by widgets-apply.
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/bin"))
import i18n
from widget_lib import mkwin, one_instance, make_flip, flip_set

pidf = one_instance("clock")

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

win, box = mkwin("clock", """
#wtime { font-size: 34px; font-weight: bold; }
#wdate { font-size: 12px; color: rgba(241,241,243,0.72); }
""")

tstack = make_flip(box, "wtime", "", ttype="slide-up", dur=340)
dstack = make_flip(box, "wdate", "", ttype="fade", dur=450)


def tick():
    flip_set(tstack, i18n.render(i18n._conf_val("CLOCK") or "%H:%M"))
    flip_set(dstack, i18n.render("%A %d %B"))
    return True


def on_destroy(*a):
    try:
        os.unlink(pidf)
    except OSError:
        pass
    Gtk.main_quit()


tick()
GLib.timeout_add(1000, tick)
win.connect("destroy", on_destroy)
win.show_all()
Gtk.main()

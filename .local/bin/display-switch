#!/usr/bin/env bash
# display-switch — cycle laptop display modes with an external monitor.
# Order: Extend -> Mirror -> External only -> Internal only -> Extend.
# Safe no-op (toast) when no external display is connected.
# Wayland: hyprctl keyword monitor. X11: xrandr.
set -u

N() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -t 1800 -u low \
        -h "string:x-canonical-private-synchronous:fnkey" \
        "$1" "${2:-}" 2>/dev/null
}
have() { command -v "$1" >/dev/null 2>&1; }

# ---- X11 twin via xrandr ----
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ]; then
    have xrandr || { N "Display" "xrandr not found"; exit 0; }
    INT="$(xrandr 2>/dev/null | awk '/ connected primary/{print $1; exit} / connected/{if(!f){print $1; f=1}}')"
    # prefer eDP
    for d in $(xrandr 2>/dev/null | awk '/ connected/{print $1}'); do
        case "$d" in eDP*|LVDS*) INT="$d" ;; esac
    done
    EXT=""
    for d in $(xrandr 2>/dev/null | awk '/ connected/{print $1}'); do
        case "$d" in eDP*|LVDS*|"") ;; *) EXT="$d"; break ;; esac
    done
    if [ -z "$INT" ]; then N "Display" "no internal panel"; exit 0; fi
    if [ -z "$EXT" ]; then
        # cycle internal-only modes only
        xrandr --output "$INT" --auto --primary
        N "Display" "$INT only"
        exit 0
    fi
    # state machine file
    ST="$HOME/.cache/display-switch-x11"
    MODE="$(cat "$ST" 2>/dev/null || echo extend)"
    case "$MODE" in
        extend)
            xrandr --output "$INT" --auto --primary --output "$EXT" --auto --right-of "$INT"
            echo mirror > "$ST"
            N "Display" "Mirror"
            ;;
        mirror)
            xrandr --output "$INT" --auto --primary --output "$EXT" --auto --same-as "$INT"
            echo ext > "$ST"
            N "Display" "External only"
            ;;
        ext)
            xrandr --output "$INT" --off --output "$EXT" --auto --primary
            echo int > "$ST"
            N "Display" "Internal only"
            ;;
        int|*)
            xrandr --output "$EXT" --off --output "$INT" --auto --primary
            echo extend > "$ST"
            N "Display" "Extend"
            ;;
    esac
    # refresh bar
    killall -SIGUSR2 waybar 2>/dev/null || true
    exit 0
fi

have hyprctl || { N "Display" "hyprctl not found"; exit 0; }

json="$(hyprctl -j monitors all 2>/dev/null)"
[ -z "$json" ] && { N "Display" "no monitor info"; exit 0; }

parsed="$(printf '%s' "$json" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit()
ints = [m for m in d if m.get("name", "").startswith("eDP")]
exts = [m for m in d if not m.get("name", "").startswith("eDP")]
if not ints:
    sys.exit()
i = ints[0]["name"]
imode = "%dx%d@%d" % (ints[0]["width"], ints[0]["height"], round(ints[0].get("refreshRate", 60)))
if not exts:
    print(i, imode, "")
    sys.exit()
print(i, imode, exts[0]["name"])
' 2>/dev/null)"

# shellcheck disable=SC2086
set -- $parsed
INT="${1:-}"
IMODE="${2:-preferred}"
EXT="${3:-}"
[ -z "$INT" ] && { N "Display" "no internal monitor found"; exit 0; }
[ -z "$EXT" ] && { N "Display" "no external display connected"; exit 0; }

STATE="$HOME/.cache/display-mode"
cur="$(cat "$STATE" 2>/dev/null || echo 0)"
case "$cur" in ''|*[!0-9]*) cur=0 ;; esac
next=$(( (cur + 1) % 4 ))

case "$next" in
    0)
        hyprctl keyword monitor "$EXT,preferred,auto-right,auto"        >/dev/null 2>&1
        hyprctl keyword monitor "$INT,$IMODE,auto,1"                    >/dev/null 2>&1
        N "Display: Extend" "$EXT + $INT"
        ;;
    1)
        hyprctl keyword monitor "$INT,$IMODE,auto,1"                    >/dev/null 2>&1
        hyprctl keyword monitor "$EXT,preferred,auto,auto,mirror,$INT"  >/dev/null 2>&1
        N "Display: Mirror" "$EXT = $INT"
        ;;
    2)
        hyprctl keyword monitor "$EXT,preferred,auto,auto"              >/dev/null 2>&1
        hyprctl keyword monitor "$INT,disable"                          >/dev/null 2>&1
        N "Display: External only" "$EXT"
        ;;
    3)
        hyprctl keyword monitor "$EXT,disable"                          >/dev/null 2>&1
        hyprctl keyword monitor "$INT,$IMODE,auto,1"                    >/dev/null 2>&1
        N "Display: Internal only" "$INT"
        ;;
esac
printf '%s\n' "$next" > "$STATE"
exit 0

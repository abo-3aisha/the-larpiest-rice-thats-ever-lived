#!/usr/bin/env python3
# Widget Sys — CPU / MEM / TEMP rows with thin progress bars.
import os
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.local/bin"))
import widget_lib
from widget_lib import mkwin, one_instance

pidf = one_instance("sys")

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

a = widget_lib.accent()
extra = """
.slbl { font-size: 12px; min-width: 46px; }
.sprog trough { background: rgba(255,255,255,0.10); border-radius: 2px; min-height: 6px; }
.sprog progress { background: #%s; border-radius: 2px; min-height: 6px; }
""" % a

win, box = mkwin("sys", extra)

rows = []
for key in ("CPU", "MEM", "TMP"):
    r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    lbl = Gtk.Label(label=key + " 0%")
    lbl.get_style_context().add_class("slbl")
    lbl.set_halign(Gtk.Align.START)
    p = Gtk.ProgressBar()
    p.get_style_context().add_class("sprog")
    p.set_show_text(False)
    p.set_fraction(0.0)
    r.pack_start(lbl, False, False, 0)
    r.pack_start(p, True, True, 0)
    box.pack_start(r, True, True, 0)
    rows.append((lbl, p))


def val(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return 0
    try:
        return int(float(r.stdout.strip()))
    except ValueError:
        return 0


def tick():
    vals = [val(["/home/abo3aisha/.local/bin/sys-widget", k]) for k in ("cpu", "mem", "temp")]
    for (lbl, p), key, v in zip(rows, ("CPU", "MEM", "TMP"), vals):
        lbl.set_text("%s %d%%" % (key, v))
        p.set_fraction(min(1.0, v / 100.0))
    return True


def on_destroy(*a):
    try:
        os.unlink(pidf)
    except OSError:
        pass
    Gtk.main_quit()


tick()
GLib.timeout_add(2000, tick)
win.connect("destroy", on_destroy)
win.show_all()
Gtk.main()
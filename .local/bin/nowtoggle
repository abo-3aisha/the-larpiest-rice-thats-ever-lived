#!/usr/bin/env bash
# nowtoggle — open/close the nowpanel dropdown by clock click.
# Uses a pid file; no pgrep self-matching, no window-class guessing.

PIDF=/tmp/nowpanel.pid

alive() {
    local pid
    pid=$(cat "$PIDF" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    grep -q 'nowpanel' "/proc/$pid/cmdline" 2>/dev/null || return 1
    return 0
}

if alive; then
    pid=$(cat "$PIDF")
    kill "$pid" 2>/dev/null
    rm -f "$PIDF"
else
    rm -f "$PIDF"
    foot -a nowpanel -T 'Now Playing' /home/abo3aisha/.local/bin/nowpanel &
fi
#!/usr/bin/env python3
# Lock Screen Style — edit the hyprlock lock-screen widgets (SUPER+S).
#
# Follows the EXACT same convention as the desktop widget-manager:
#   (x, y) = widget's TOP-LEFT corner as a fraction of the screen.
#   Preview box top-left sits at (x, y). Drag keeps grab offset.
#   Arrow keys nudge (Shift = fine step).
#
# hyprlock mapping (halign=left + valign=top):
#   x_left = px  =>  px = round(x * sw)
#   y_top  = -py =>  py = -round(y * sh)   (y is bottom-up internally)
#
# CRITICAL: hyprlock's `position` is a LAYOUT value parsed by
# configHandleLayoutOption() in hyprlock/src/config/ConfigManager.cpp,
# which does VALUE.find(',') and ERRORS OUT with no comma → the value
# silently falls back to the default 0,0 (then halign/valign alone pile
# every widget into one corner). ALWAYS write `position = X, Y`.
#
# Run `lockscreen-style --build` to regenerate hyprlock.conf headlessly.
import json
import math
import os
import shutil
import subprocess
import sys
import warnings

import widget_lib

LOCK_DIR = os.path.expanduser("~/.config/lockscreen")
LOCK_JSON = os.path.join(LOCK_DIR, "lockscreen.json")
HL_CONF = os.path.expanduser("~/.config/hypr/hyprlock.conf")
BACKUP = os.path.expanduser("~/backups/hyprlock-before-lockscreen-style.conf")

KEYS = ["clockday", "clockana", "clock", "date", "hijri", "prayer",
        "music", "sys", "miku", "frame"]
NAMES = {
    "clockday": "Day Clock", "clockana": "Cookie Clock", "clock": "Clock",
    "date": "Date", "hijri": "Hijri Date", "prayer": "Next Prayer",
    "music": "Music", "sys": "System", "miku": "Miku", "frame": "Photo Frame",
}
TEXT = {
    "clock":    "cmd[update:1000] ~/.local/bin/i18n.py format",
    "date":     "cmd[update:30000] ~/.local/bin/i18n.py format --date",
    "clockday": "cmd[update:30000] ~/.local/bin/lockclockday",
    "hijri":    "cmd[update:3600000] ~/.local/bin/hijri-text",
    "prayer":   "cmd[update:30000] ~/.local/bin/prayer-times --next",
    "music":    "cmd[update:2000] playerctl -a metadata --format '{{artist}} - {{title}}' 2>/dev/null || echo 'No music'",
    "sys":      'cmd[update:5000] echo "CPU $(~/.local/bin/sys-widget cpu)%  MEM $(~/.local/bin/sys-widget mem)%"',
    "miku":     "cmd[update:5000] ~/.local/bin/miku-kaomoji",
}
IMAGE_CFG = {
    "clockana": {"path": "~/.cache/lockscreen-clockana.png", "reload": 5,  "cmd": "~/.local/bin/lockclockana"},
    "frame":    {"path": "~/.cache/lockscreen-frame.png",    "reload": 12, "cmd": "~/.local/bin/lockframe"},
}
DEFAULTS = {
    "clockday": {"enabled": False, "x": 0.50, "y": 0.02, "size": 46},
    "clockana": {"enabled": True,  "x": 0.50, "y": 0.04, "size": 300},
    "clock":    {"enabled": True,  "x": 0.50, "y": 0.30, "size": 72},
    "date":     {"enabled": True,  "x": 0.50, "y": 0.50, "size": 18},
    "hijri":    {"enabled": True,  "x": 0.50, "y": 0.56, "size": 30},
    "prayer":   {"enabled": True,  "x": 0.50, "y": 0.64, "size": 30},
    "music":    {"enabled": False, "x": 0.50, "y": 0.30, "size": 26},
    "sys":      {"enabled": False, "x": 0.02, "y": 0.10, "size": 26},
    "miku":     {"enabled": False, "x": 0.50, "y": 0.85, "size": 60},
    "frame":    {"enabled": False, "x": 0.72, "y": 0.55, "size": 320},
}

STEP = 0.004
FINE = 0.001

FIXED_BLOCKS = """general {
    no_fade_in = false
    no_fade_out = true
    grace = 2
    ignore_empty_input = true
    hide_cursor = true
    immediate_render = true
}

background {
    monitor =
    path =
    color = rgba(23, 23, 26, 0.40)
    blur_passes = 3
    blur_size = 9
    noise = 0.02
    contrast = 0.9
    brightness = 0.45
    vibrancy = 0.2
    vibrancy_darkness = 0.15
}

input-field {
    monitor =
    size = 280, 46
    outline_thickness = 2
    outer_color = rgba(233, 100, 58, 0.85)
    inner_color = rgba(23, 23, 26, 0.85)
    font_color = rgba(235, 235, 235, 1.0)
    placeholder_text = <i>Enter password…</i>
    placeholder_color = rgba(235, 235, 235, 0.4)
    fade_on_empty = true
    dots_size = 0.18
    dots_spacing = 0.4
    dots_center = true
    halign = center
    valign = center
    position = 0, 0
}
"""

LABEL_TPL = """/* @@lockscreen-widget@@ */
label {{
    monitor =
    text = {text}
    color = rgba(239, 241, 244, 1.0)
    font_size = {size}
    font_family = "JetBrainsMono Nerd Font"
    halign = left
    valign = top
    position = {px}, {py}
    shadow_passes = 2
    shadow_size = 6
    shadow_color = rgba(0, 0, 0, 0.55)
}}
"""

IMAGE_TPL = """/* @@lockscreen-widget@@ */
image {{
    monitor =
    path = {path}
    size = {size}
    reload_time = {reload}
    reload_cmd = {cmd}
    rounding = 0
    border_size = 0
    halign = left
    valign = top
    position = {px}, {py}
}}
"""


def load():
    try:
        return json.load(open(LOCK_JSON)).get("widgets", {})
    except Exception:
        return {}


def merged(data=None):
    out = {k: dict(DEFAULTS[k]) for k in KEYS}
    loaded = load() if data is None else data
    for k in KEYS:
        out[k].update(loaded.get(k, {}))
    return out


def build_conf(data):
    sw, sh = widget_lib.monitor_size()
    data = merged(data)
    block = ""
    for k in KEYS:
        e = data.get(k) or {}
        if not e.get("enabled"):
            continue
        size = int(e.get("size") or DEFAULTS[k]["size"])
        px = int(round(float(e.get("x", 0.5)) * sw))
        py = -int(round(float(e.get("y", 0.5)) * sh))
        if k in IMAGE_CFG:
            cfg = IMAGE_CFG[k]
            block += IMAGE_TPL.format(path=cfg["path"], reload=cfg["reload"],
                                      cmd=cfg["cmd"], size=size, px=px, py=py) + "\n"
        else:
            block += LABEL_TPL.format(text=TEXT[k], size=size, px=px, py=py) + "\n"
    conf = (FIXED_BLOCKS
            + "\n\n/* Widgets managed by lockscreen-style (SUPER+S) */\n\n"
            + block.strip() + "\n")
    # guard: hyprlock's LAYOUT parser needs a comma, else position stays 0,0
    for line in conf.splitlines():
        if line.strip().startswith("position") and "," not in line:
            raise RuntimeError("hyprlock position must be comma-separated: %r" % line)
    return conf


def _prep_images(data):
    for k, cfg in IMAGE_CFG.items():
        if data.get(k, {}).get("enabled"):
            subprocess.run([cfg["cmd"]], shell=True, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def save(data):
    os.makedirs(LOCK_DIR, exist_ok=True)
    with open(LOCK_JSON, "w") as f:
        json.dump({"v": 3, "widgets": data}, f, indent=2)
    if not os.path.exists(BACKUP) and os.path.exists(HL_CONF):
        shutil.copy2(HL_CONF, BACKUP)
    _prep_images(data)
    with open(HL_CONF, "w") as f:
        f.write(build_conf(data))
    subprocess.run(["notify-send", "-a", "lockscreen-style", "-u", "normal", "-t", "5000",
                    "Lock screen", "Saved. Press SUPER+L to preview."], check=False)


def _T(key):
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import i18n
        return i18n.t(key)
    except Exception:
        return key


def build_cli():
    save(merged())
    print("wrote %s" % HL_CONF)
    return 0


if "--build" in sys.argv:
    sys.exit(build_cli())


warnings.filterwarnings("ignore", module="gi")
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk


class Manager(Gtk.Window):
    def __init__(self):
        self.T = _T
        super().__init__(title="Lock Screen Style")
        self.set_default_size(860, 640)
        # hard floor: 10 rows + hint + poslbl need ~545px; without this Hyprland
        # sometimes maps the window short and GTK clips the rows to 1-2.
        self.set_size_request(720, 560)
        self.set_can_focus(True)
        self.data = merged()
        self.active = None
        self.dragging = False
        self.grab = (0.0, 0.0)
        self.spins = {}
        self.checks = {}
        self.rows = {}

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        root.set_margin_start(12)
        root.set_margin_end(12)
        root.set_margin_top(12)
        root.set_margin_bottom(12)
        self.add(root)

        title = Gtk.Label(label=("Lock Screen Widgets — drag the boxes to place them "
                                 "(same as the desktop widget manager). Arrow keys "
                                 "nudge precisely (Shift = fine step). SUPER+L to preview."))
        title.set_line_wrap(True)
        title.set_halign(Gtk.Align.START)
        root.pack_start(title, False, False, 0)

        mid = Gtk.Box(spacing=14)
        root.pack_start(mid, True, True, 0)

        lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lst.set_size_request(250, -1)
        mid.pack_start(lst, False, False, 0)
        for k in KEYS:
            row = Gtk.Box(spacing=8)
            chk = Gtk.CheckButton(label=NAMES[k])
            chk.set_active(bool(self.data[k].get("enabled")))
            row.pack_start(chk, True, True, 0)
            sp = Gtk.SpinButton.new_with_range(14, 600, 1)
            sp.set_value(int(self.data[k].get("size", DEFAULTS[k]["size"])))
            sp.set_width_chars(3)
            row.pack_start(sp, False, False, 0)
            lst.pack_start(row, False, False, 0)
            self.checks[k] = chk
            self.spins[k] = sp
            self.rows[k] = row

        hint = Gtk.Label(label=self.T("LS_HINT"))
        hint.set_halign(Gtk.Align.START)
        hint.set_line_wrap(True)
        hint.get_style_context().add_class("dim")
        lst.pack_start(hint, False, False, 0)

        self.poslbl = Gtk.Label(label="")
        self.poslbl.set_halign(Gtk.Align.START)
        self.poslbl.get_style_context().add_class("dim")
        lst.pack_start(self.poslbl, False, False, 0)

        self.da = Gtk.DrawingArea()
        self.da.set_size_request(420, 240)
        self.da.set_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                           Gdk.EventMask.BUTTON_RELEASE_MASK |
                           Gdk.EventMask.POINTER_MOTION_MASK)
        self.da.connect("draw", self.on_draw)
        self.da.connect("button-press-event", self.on_press)
        self.da.connect("button-release-event", self.on_release)
        self.da.connect("motion-notify-event", self.on_motion)
        mid.pack_start(self.da, True, True, 0)

        btns = Gtk.Box(spacing=8)
        applyb = Gtk.Button(label=self.T("LS_SAVE"))
        applyb.connect("clicked", self.on_apply)
        closeb = Gtk.Button(label=self.T("LS_CLOSE"))
        closeb.connect("clicked", lambda *a: self.destroy())
        btns.pack_start(applyb, False, False, 0)
        btns.pack_start(closeb, False, False, 0)
        self.status = Gtk.Label(label="")
        self.status.get_style_context().add_class("dim")
        btns.pack_start(self.status, False, False, 8)
        root.pack_start(btns, False, False, 0)

        self.add_css()
        self.connect("key-press-event", self.on_key)

    def add_css(self):
        p = Gtk.CssProvider()
        p.load_from_data(b"window { background: rgba(16,16,20,0.96); }\n.dim { color: rgba(230,230,235,0.6); font-size: 11px; }")
        try:
            Gtk.StyleContext.add_provider_for_screen(self.get_screen(), p, 800)
        except Exception:
            pass

    def preview_geom(self):
        aw = self.da.get_allocated_width()
        ah = self.da.get_allocated_height()
        scale = min(aw / 1600.0, ah / 900.0)
        w, h = 1600 * scale, 900 * scale
        return (aw - w) / 2, (ah - h) / 2, w, h

    def box_rect(self, k, e, ox, oy, w, h):
        x = ox + e.get("x", 0.5) * w
        y = oy + e.get("y", 0.5) * h
        size = int(e.get("size", DEFAULTS[k]["size"]))
        s = w / 1600.0
        if k in IMAGE_CFG:
            bw = bh = size * s
        else:
            bw = max(100, size * 5.0 * s)
            bh = max(28, size * 1.6 * s)
        return x, y, bw, bh

    def on_draw(self, da, ctx):
        a = widget_lib.accent()
        ox, oy, w, h = self.preview_geom()
        ctx.set_source_rgba(0.09, 0.09, 0.12, 1)
        ctx.rectangle(ox, oy, w, h)
        ctx.fill()
        ctx.set_source_rgba(1, 1, 1, 0.18)
        ctx.set_line_width(1)
        ctx.rectangle(ox, oy, w, h)
        ctx.stroke()
        ctx.set_source_rgba(1, 1, 1, 0.05)
        for i in range(1, 10):
            ctx.move_to(ox + w * i / 10.0, oy)
            ctx.line_to(ox + w * i / 10.0, oy + h)
            ctx.move_to(ox, oy + h * i / 10.0)
            ctx.line_to(ox + w, oy + h * i / 10.0)
        ctx.stroke()
        for k in KEYS:
            e = self.data.get(k, {})
            if not e.get("enabled"):
                continue
            x, y, bw, bh = self.box_rect(k, e, ox, oy, w, h)
            if k == self.active:
                ctx.set_source_rgba(1, 0.9, 0.45, 0.95)
            else:
                c = tuple(int(a[i:i + 2], 16) / 255 for i in (0, 2, 4))
                ctx.set_source_rgba(c[0], c[1], c[2], 0.9)
            r = 5
            ctx.new_path()
            ctx.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
            ctx.arc(x + bw - r, y + r, r, 1.5 * math.pi, 2 * math.pi)
            ctx.arc(x + bw - r, y + bh - r, r, 0, 0.5 * math.pi)
            ctx.arc(x + r, y + bh - r, r, 0.5 * math.pi, math.pi)
            ctx.close_path()
            ctx.fill()
            ctx.set_source_rgba(0, 0, 0, 0.45)
            ctx.set_font_size(10)
            ctx.move_to(x + 6, y + 12)
            ctx.show_text(NAMES[k])
        return False

    def pick(self, px, py):
        ox, oy, w, h = self.preview_geom()
        for k in reversed(KEYS):
            e = self.data.get(k, {})
            if not e.get("enabled"):
                continue
            x, y, bw, bh = self.box_rect(k, e, ox, oy, w, h)
            if x <= px <= x + bw and y <= py <= y + bh:
                return k
        return None

    def update_poslbl(self):
        if not self.active:
            self.poslbl.set_text("")
            return
        e = self.data.get(self.active, {})
        self.poslbl.set_text("%s — x %.1f%%  y %.1f%%" % (
            NAMES[self.active], e.get("x", 0.5) * 100, e.get("y", 0.5) * 100))

    def on_press(self, da, ev):
        k = self.pick(ev.x, ev.y)
        if k:
            self.active = k
            self.dragging = True
            ox, oy, w, h = self.preview_geom()
            e = self.data[k]
            bx = ox + e.get("x", 0.5) * w
            by = oy + e.get("y", 0.5) * h
            self.grab = ((ev.x - bx) / max(1.0, w), (ev.y - by) / max(1.0, h))
        else:
            self.active = None
            self.dragging = False
        self.update_poslbl()
        da.queue_draw()
        return True

    def on_release(self, da, ev):
        self.dragging = False
        return True

    def on_motion(self, da, ev):
        if not self.active or not self.dragging:
            return True
        ox, oy, w, h = self.preview_geom()
        e = self.data.setdefault(self.active, {})
        ex = max(0.0, min(1.0, (ev.x - ox) / w - self.grab[0]))
        ey = max(0.0, min(1.0, (ev.y - oy) / h - self.grab[1]))
        e["x"] = round(ex, 4)
        e["y"] = round(ey, 4)
        self.update_poslbl()
        da.queue_draw()
        return True

    def on_key(self, win, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.active = None
            self.update_poslbl()
            self.da.queue_draw()
            return True
        if not self.active:
            return False
        step = FINE if ev.state & Gdk.ModifierType.SHIFT_MASK else STEP
        e = self.data.setdefault(self.active, {})
        moved = False
        if ev.keyval in (Gdk.KEY_Left, Gdk.KEY_KP_Left):
            e["x"] = round(max(0.0, e.get("x", 0.5) - step), 4)
            moved = True
        elif ev.keyval in (Gdk.KEY_Right, Gdk.KEY_KP_Right):
            e["x"] = round(min(1.0, e.get("x", 0.5) + step), 4)
            moved = True
        elif ev.keyval in (Gdk.KEY_Up, Gdk.KEY_KP_Up):
            e["y"] = round(max(0.0, e.get("y", 0.5) - step), 4)
            moved = True
        elif ev.keyval in (Gdk.KEY_Down, Gdk.KEY_KP_Down):
            e["y"] = round(min(1.0, e.get("y", 0.5) + step), 4)
            moved = True
        if moved:
            self.update_poslbl()
            self.da.queue_draw()
        return moved

    def on_apply(self, *a):
        for k in KEYS:
            self.data[k]["enabled"] = bool(self.checks[k].get_active())
            self.data[k]["size"] = int(self.spins[k].get_value())
        save(self.data)
        self.status.set_text(self.T("LS_SAVE"))
        GLib.timeout_add(2500, lambda: (self.status.set_text(""), False)[1])


GEOM_LOG = os.path.expanduser("~/.cache/lockscreen-style-geom.log")


def geom_log(win):
    """Dump the real allocations once the window is mapped.

    Catches the "only the first row shows" bug with facts: is the window
    short (clipping), are the rows present but 0-height, or missing entirely.
    """
    try:
        import datetime
        lines = ["=== %s ===" % datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")]
        w, h = win.get_size()
        aw, ah = win.get_allocated_width(), win.get_allocated_height()
        lines.append("window requested %dx%d  allocated %dx%d" % (w, h, aw, ah))
        lines.append("rows in KEYS=%d  rows built=%d  checks=%d" % (
            len(KEYS), len(win.rows), len(win.checks)))
        for k in KEYS:
            r = win.rows.get(k)
            c = win.checks.get(k)
            if r is None:
                lines.append("  %-10s MISSING ROW" % k)
                continue
            a = r.get_allocation()
            ca = c.get_allocation() if c is not None else None
            lines.append("  %-10s row=%dx%d @%d,%d  chk=%s mapped=%s" % (
                k, a.width, a.height, a.x, a.y,
                ("%dx%d" % (ca.width, ca.height)) if ca else "?",
                r.get_mapped()))
        with open(GEOM_LOG, "w") as f:
            f.write("\n".join(lines) + "\n")
    except Exception as ex:
        try:
            with open(GEOM_LOG, "w") as f:
                f.write("geom_log failed: %r\n" % (ex,))
        except OSError:
            pass
    return False


def main():
    win = Manager()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    GLib.timeout_add(800, lambda: (geom_log(win), False)[1])
    Gtk.main()


if __name__ == "__main__":
    main()

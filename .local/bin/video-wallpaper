#!/usr/bin/env bash
# video-wallpaper — kept only as a compatibility shim.
#
# Everything moved into apply-wallpaper so images and videos share one animation.
# Nothing in this rice calls this file any more (apply-wallpaper used to be the
# only caller and no longer execs it), but it stays so anything external or
# hand-typed keeps working.
#
# Usage: video-wallpaper /path/to/video
set -u
video="${1:-}"
if [ -z "$video" ]; then
    notify-send -t 4000 "Video wallpaper" "no video given" 2>/dev/null
    exit 1
fi
[ -f "$video" ] || {
    notify-send -t 4000 "Video wallpaper" "not found: $video" 2>/dev/null
    exit 1
}
exec "$HOME/.local/bin/apply-wallpaper" "$video"
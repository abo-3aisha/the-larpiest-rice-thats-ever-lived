#!/usr/bin/env bash
eval "$("$HOME/.local/bin/i18n.py" dump)"
# perf-mode — the single switch behind the Performance app.
#   perf-mode on     → full saver : animations + blur off, cava + widgets stopped.
#                                   This is the idle drop target, not a profile name;
#                                   the Power Saver profile looks like Gaming until idle.
#   perf-mode off    → Balanced: everything back exactly as it was
#   perf-mode status → print the current mode + what each toggle is doing
#   perf-mode watch  → idle-timer daemon (logs you into Saver when the
#                      machine has been untouched for TIMER minutes, restores
#                      Balanced on the first keypress)
# Settings live in ~/.config/rice/perf.conf; the Hyprland half is written to
# ~/.config/rice/perf.lua which hyprland.lua loads at startup.
B="$HOME/.local/bin"
CONF="$HOME/.config/rice/perf.conf"
PLUA="$HOME/.config/rice/perf.lua"

# add any key a newer rice added, so an old perf.conf still loads clean
ensure_keys() {
    [ -f "$CONF" ] || return 0
    grep -q '^IDLE_SCREEN=' "$CONF" || echo 'IDLE_SCREEN=0' >> "$CONF"
    grep -q '^LOGIN_ONLY=' "$CONF" || echo 'LOGIN_ONLY=0' >> "$CONF"
    grep -q '^PROFILE=' "$CONF" || echo 'PROFILE=Balanced' >> "$CONF"
}

set_defaults() {
    [ -f "$CONF" ] && return 0        # never clobber a live profile
    cat > "$CONF" <<'EOF'
# rice: performance profile — written by performance-gui
MODE=balanced
ANIMATIONS=1
BLUR=1
CAVA=1
WIDGETS=1
TIMER=0
AUTO=1
IDLE_SCREEN=0
LOGIN_ONLY=0
EOF
}
ensure_keys
set_defaults

get() { grep -E "^$1=" "$CONF" 2>/dev/null | head -1 | cut -d= -f2; }
setv() { sed -i "s/^$1=.*/$1=$2/" "$CONF"; }
LOG="$HOME/.cache/perf-mode.log"

# Probe once whether the running Hyprland accepts a live variable write.
# Probing is what stops this script from being "silent": every attempt is
# recorded, so a future failure is visible instead of invisible.
HYPR_KIND=""
detect_hypr() {
    local key=$1 val=$2
    if [ -z "$HYPR_KIND" ]; then
        local out
        out=$(hyprctl setvar "$key" "$val" 2>&1)
        case "$out" in
            *unknown*|*Unknown*) HYPR_KIND="reload"
                printf '[perf] hyprctl setvar unsupported (%s); using reload\n' \
                    "$(printf '%s' "$out" | tr -d '\n')" >> "$LOG" ;;
            "") HYPR_KIND="setvar" ;;
            *)   HYPR_KIND="reload"
                printf '[perf] hyprctl setvar said: %s\n' \
                    "$(printf '%s' "$out" | tr -d '\n')" >> "$LOG" ;;
        esac
    fi
    [ "$HYPR_KIND" = "setvar" ] || return 1
    hyprctl setvar "$key" "$val" >/dev/null 2>&1
}

# ------------------------------------------------------------------ saver --
# Semantics: every toggle means "keep this ON".
#   saver     → everything OFF (maximum saving, minimum visuals)
#   balanced  → a feature is ON only if its toggle says so
# so the toggles decide what comes back, and you can also pre-emptively park
# something while staying in balanced.
apply_saver() {
    local saver=$1   # 1 = saver, 0 = balanced
    local anim blur

    if [ "$saver" = 1 ]; then
        anim=false
        blur=false
    else
        anim=$([ "$(get ANIMATIONS)" = 1 ] && echo true  || echo false)
        blur=$([ "$(get BLUR)" = 1 ] && echo true  || echo false)
    fi

    # persistent: the lua snippet hyprland.lua loads at startup
    #
    # ORDER MATTERS. The reload used to sit ABOVE this write, so it re-read the
    # PREVIOUS perf.lua and every profile applied the values of the profile
    # before it. Writing first, then reloading, is what makes the change stick.
    # Values only -- deliberately NOT an hl.config block.
    # HyprMod merges config calls in order, and a block from perf-mode loaded
    # last replaced decoration.blur wholesale, wiping size/passes/vibrancy, while
    # loaded early it was overwritten by hyprland.lua's own block and never took
    # effect at all. A plain table has no merge semantics: hyprland.lua reads
    # these two flags and uses them inside its own single hl.config.
    cat > "$PLUA" <<EOF
-- rice: performance profile (generated by perf-mode) -- do not edit by hand
-- Read by hyprland.lua and applied inside its own hl.config blocks.
RICE_PERF = { anim = $anim, blur = $blur }
EOF

    # How to reach the live compositor.
    #
    # This Hyprland is 0.5.1 with HyprMod, which rules out every direct route:
    #   hyprctl setvar animations:enabled false   -> "unknown request"  (0.45+)
    #   hyprctl keyword animations:enabled false  -> "keyword can't work with
    #                                               non-legacy parsers"
    #   hyprctl eval ...                          -> layout dispatch only
    # So the Lua file is the runtime: hyprland.lua line 13 dofiles perf.lua on
    # every reload. detect_hypr() prefers a direct call if a future version
    # re-enables one, and logs the decision so nothing fails silently.
    if detect_hypr animations:enabled "$anim"; then :
    else
        hyprctl reload >/dev/null 2>&1
    fi

    # the two 60fps / always-on layer surfaces
    # Both directions matter. Only starting them meant a profile that turned
    # cava or the widgets OFF did nothing at all, because whatever was already
    # running just kept running.
    local want_cava=0 want_widgets=0
    if [ "$saver" = 1 ]; then
        pkill -f cava-dock >/dev/null 2>&1
        pkill -f 'widget-(clockana|clock|music|sys|miku|prayer|hijri)' >/dev/null 2>&1
    else
        [ "$(get CAVA)" = 1 ] && want_cava=1
        [ "$(get WIDGETS)" = 1 ] && want_widgets=1
        if [ "$want_cava" = 1 ]; then
            pgrep -f cava-dock >/dev/null 2>&1 || {
                rm -f "$HOME/.cache/cava-dock.pid" 2>/dev/null
                (setsid "$B/cava-dock" >/dev/null 2>&1 &)
            }
        else
            pkill -f cava-dock >/dev/null 2>&1
            rm -f "$HOME/.cache/cava-dock.pid" 2>/dev/null
        fi
        if [ "$want_widgets" = 1 ]; then
            "$B/widgets-apply" >/dev/null 2>&1
        else
            pkill -f 'widget-(clockana|clock|music|sys|miku|prayer|hijri)' >/dev/null 2>&1
        fi
    fi

    # ---- the Samsung-style "one frame" step -------------------------------
    # A saver run on its own still repaints: the clock ticks, the tray moves.
    # With IDLE_SCREEN the display itself is dropped to a single static frame
    # (DPMS off) after IDLE_SCREEN minutes of no input, and Hyprland wakes it
    # on the very next keypress — the same trick a phone does when it stops
    # refreshing a screen nobody is looking at. LOGIN_ONLY parks the optional
    # surfaces when no app window is open, so a game on a second monitor is
    # never mistaken for "idle".
    local screen; screen=$(get IDLE_SCREEN)
    if [ "$saver" = 1 ] && [ "${screen:-0}" -gt 0 ]; then
        ( sleep $((screen * 60))
          hyprctl dispatch dpms on >/dev/null 2>&1
          hyprctl dispatch dpms off >/dev/null 2>&1 ) &
        disown 2>/dev/null
        loginctl lock-session >/dev/null 2>&1   # wake on input
    fi

    if [ "$(get LOGIN_ONLY)" = 1 ]; then
        if [ -z "$(hyprctl -j clients 2>/dev/null | tr -d ' \n' | sed 's/[][]//g')" ]; then
            pkill -f cava-dock >/dev/null 2>&1
            pkill -f 'widget-(clockana|clock|music|sys|miku|prayer|hijri)' >/dev/null 2>&1
        fi
    fi

    setv MODE $([ "$saver" = 1 ] && echo saver || echo balanced)
    # The Performance app already announces the real profile name. Without this
    # guard every profile answered with "balanced", because apply_saver only
    # knows two states and the app is the one that knows which profile was picked.
    if [ "${RICE_PERF_QUIET:-0}" != "1" ]; then
        [ "$saver" = 1 ] && notify "$T_PM_SAVER_DESC" \
                         || notify "$T_PM_BALANCED_DESC"
    fi
    return 0
}

notify() { command -v notify-send >/dev/null && notify-send -a Rice -t 2200 "$1"; }

# ----------------------------------------------------------------- status --
mem_saved() {
    # RSS of the layer surfaces a saver run parks, in MB
    local kb=0
    for pat in cava-dock widget-clockana widget-clock widget-music widget-sys \
               widget-miku widget-prayer widget-hijri; do
        for p in $(pgrep -f "$pat" 2>/dev/null); do
            r=$(awk '/VmRSS/{print $2}' "/proc/$p/status" 2>/dev/null)
            kb=$((kb + ${r:-0}))
        done
    done
    echo $((kb / 1024))
}

status() {
    echo "profile=$(get PROFILE)"
    echo "animations=$(get ANIMATIONS) blur=$(get BLUR) cava=$(get CAVA) widgets=$(get WIDGETS)"
    echo "timer=$(get TIMER) auto=$(get AUTO)"
    echo "screen_after=$(get IDLE_SCREEN)min login_only=$(get LOGIN_ONLY)"
    echo "reclaimable_mb=$(mem_saved)"
    echo "used_mb=$(free -m 2>/dev/null | awk '/^Mem:/{print $3}')"
}

# ------------------------------------------------------------------ watch --
watch() {
    local idle_t=0 last=""
    while true; do
        local timer; timer=$(get TIMER)
        if [ "${timer:-0}" -gt 0 ] && [ "$(get AUTO)" = 1 ]; then
            local hint
            hint=$(loginctl show-session "${XDG_SESSION_ID:-self}" -p IdleHint \
                   --value 2>/dev/null)
            if [ "$hint" = "yes" ]; then
                idle_t=$((idle_t + 5))
            else
                idle_t=0
            fi
            if [ "$idle_t" -ge $((timer * 60)) ] && [ "$(get MODE)" != "saver" ]; then
                apply_saver 1
            elif [ "$idle_t" -eq 0 ] && [ "$(get MODE)" = "saver" ] && [ "$last" = "saver" ]; then
                apply_saver 0
            fi
            [ "$(get MODE)" = "saver" ] && last="saver" || last=""
        fi
        sleep 5
    done
}

# ------------------------------------------------------------------- main --
case "${1:-status}" in
    on|saver)      apply_saver 1 ;;
    off|balanced)  apply_saver 0 ;;
    status)        status ;;
    watch)         watch ;;
    *)             echo "usage: perf-mode {on|off|status|watch}" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# pick-wallpaper — fullscreen GTK coverflow picker (Super+W): arrows browse,
# Enter applies, Esc closes. No filenames, no terminal. Window is FULLSCREEN
# (centered content inside) — no float/blur/opacity rules needed; those had to
# be applied via `hyprctl keyword windowrule` because HyprMod hl.window_rule
# rejects blur-family keys and a throw would die inside rules.lua's pcall and
# kill every wofi/swaync layer rule. We now purge any older leftovers.
W=title:^Wallpaper\ Picker$
LOG="$HOME/.cache/wallpaper-picker/error.log"
mkdir -p "$HOME/.cache/wallpaper-picker" 2>/dev/null

if command -v hyprctl >/dev/null 2>&1; then
    hyprctl keyword windowrule "unset,$W" >/dev/null 2>&1
fi

"$HOME/.local/bin/wallpaper-picker" 2>"$LOG"
rc=$?
if [ $rc -ne 0 ] && [ -s "$LOG" ]; then
    notify-send -t 8000 "Wallpaper Picker" "$(head -c 700 "$LOG")" 2>/dev/null
fi
exit $rc
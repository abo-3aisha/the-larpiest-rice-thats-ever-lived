#!/usr/bin/env bash
# session-menu — power menu for the waybar power button.
# Delegates to wlogout (the SAME tool as SUPER+SHIFT+E) with its DEFAULT layout:
# buttons_per_row = 3, so the 3 entries sit in ONE HORIZONTAL ROW (user wanted
# "بالعرض مو بالطول"). Falls back to a wofi glyph dropdown if wlogout is
# missing. Log out uses logind (HyprMod hijacks `hyprctl dispatch`).
set -u

# wlogout is Wayland-only — skip it on X11 (bspwm twin).
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ]; then
    command -v wlogout >/dev/null 2>&1 || true
elif command -v wlogout >/dev/null 2>&1; then
    exec wlogout
fi

menu=""
for m in wofi rofi fuzzel; do
    command -v "$m" >/dev/null 2>&1 && menu="$m" && break
done

if [ -z "$menu" ]; then
    notify-send -u low -t 2600 "$T_SES_TITLE" "$T_SES_NO_MENU" 2>/dev/null
    exit 1
fi

eval "$("$HOME/.local/bin/i18n.py" dump)"

# Icon-only vertical list (NO labels): Log out / Sleep / Reboot / Power off.
glyphs=(󰍃 󰒲 󰜎 󰐥)
opts="$(printf '%s\n' "${glyphs[@]}")"

case "$menu" in
    wofi)   sel="$(printf '%s' "$opts" | wofi --dmenu --prompt "⏻" --hide-search --location top_right --height 66 --columns 4 --width 220 2>/dev/null)" ;;
    rofi)   sel="$(printf '%s' "$opts" | rofi -dmenu -p "⏻" -lines 4 -columns 1 2>/dev/null)" ;;
    fuzzel) sel="$(printf '%s' "$opts" | fuzzel --dmenu --prompt "⏻" --anchor top-right --lines 4 --columns 1 --width 100 2>/dev/null)" ;;
esac

# Dispatch by INDEX: match the picked glyph against the array.
sel="${sel//[$'\r\n\t ']/}"
idx=-1
for i in "${!glyphs[@]}"; do
    [ "${glyphs[$i]}" = "$sel" ] && idx=$i && break
done

confirm() {
    local q="$1" cmd="$2" y
    y=$(printf '󰄬  %s\n󰅙  %s\n' "$T_SES_CONFIRM_YES" "$T_SES_CONFIRM_NO" \
        | wofi --dmenu --prompt "$q" --height 110 --columns 2 2>/dev/null)
    [ -z "$y" ] && return 1
    case "${y#*  }" in
        "$T_SES_CONFIRM_YES"*) "$cmd" ;;
        *) return 1 ;;
    esac
}

do_logout() {
    if command -v loginctl >/dev/null 2>&1 && [ -n "${XDG_SESSION_ID:-}" ]; then
        loginctl terminate-session "$XDG_SESSION_ID"
    else
        pkill -x Hyprland || hyprctl dispatch exit
    fi
}

case "$idx" in
    0) confirm "$T_SES_LOGOUT_Q"   do_logout            || exit 0 ;;
    1) systemctl suspend ;;
    2) confirm "$T_SES_REBOOT_Q"   "systemctl reboot"   || exit 0 ;;
    3) confirm "$T_SES_SHUTDOWN_Q" "systemctl poweroff" || exit 0 ;;
    *) exit 0 ;;
esac
exit 0

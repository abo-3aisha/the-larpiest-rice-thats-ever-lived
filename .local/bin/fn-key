#!/usr/bin/env bash
# fn-key — laptop Fn-row actions with OSD-style notifications.
# One notify id (fnkey) so toasts replace each other instead of stacking.
# Usage: fn-key <vol-up|vol-down|vol-mute|mic-mute|bright-up|bright-down|
#                 touchpad|touchpad-on|touchpad-off|airplane|wifi|display|
#                 kbd-up|kbd-down|kbd-toggle|sleep>
set -u

N() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -t 1600 -u low \
        -h "string:x-canonical-private-synchronous:fnkey" \
        "$1" "${2:-}" 2>/dev/null
}
have() { command -v "$1" >/dev/null 2>&1; }

vol_pct()   { wpctl get-volume @DEFAULT_AUDIO_SINK@   2>/dev/null | awk '{printf "%d", $2*100}'; }
vol_muted() { wpctl get-volume @DEFAULT_AUDIO_SINK@   2>/dev/null | grep -q MUTED; }
src_muted() { wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED; }
br_pct()    { brightnessctl -m 2>/dev/null | awk -F, '{gsub(/%/,"",$4); print $4}'; }
kbd_ok()    { brightnessctl -d '*kbd*' get >/dev/null 2>&1; }
kbd_pct()   { brightnessctl -d '*kbd*' -m 2>/dev/null | awk -F, '{gsub(/%/,"",$4); print $4}'; }

tp_name() {
    hyprctl -j devices 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for k in ("mice", "touch", "tablets", "keyboards"):
    for x in d.get(k, []):
        n = x.get("name", "")
        if "touchpad" in n.lower() or "trackpad" in n.lower():
            print(n)
            raise SystemExit
' 2>/dev/null
}

tp_apply() { # $1 = on|off
    local name
    name="$(tp_name)"
    if [ -z "$name" ]; then N "Touchpad" "device not found"; return 1; fi
    if [ "$1" = off ]; then
        hyprctl keyword "device[$name]:enabled" "false" >/dev/null 2>&1
        : > "$HOME/.cache/fn-touchpad-off"
        N "Touchpad off"
    else
        hyprctl keyword "device[$name]:enabled" "true" >/dev/null 2>&1
        rm -f "$HOME/.cache/fn-touchpad-off"
        N "Touchpad on"
    fi
}

case "${1:-}" in
    vol-up|vol-down)
        have wpctl || { N "Volume" "wpctl not installed"; exit 0; }
        if [ "$1" = vol-up ]; then
            wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ >/dev/null 2>&1
        else
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- >/dev/null 2>&1
        fi
        if vol_muted; then N "Volume $(vol_pct)%" "muted"; else N "Volume $(vol_pct)%"; fi
        ;;
    vol-mute)
        have wpctl || { N "Volume" "wpctl not installed"; exit 0; }
        if vol_muted; then
            wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 >/dev/null 2>&1
            N "Volume unmuted" "$(vol_pct)%"
        else
            wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 >/dev/null 2>&1
            N "Volume muted"
        fi
        ;;
    mic-mute)
        have wpctl || { N "Microphone" "wpctl not installed"; exit 0; }
        if src_muted; then
            wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 >/dev/null 2>&1
            N "Microphone unmuted"
        else
            wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 >/dev/null 2>&1
            N "Microphone muted"
        fi
        ;;
    bright-up|bright-down)
        have brightnessctl || { N "Brightness" "brightnessctl not installed"; exit 0; }
        if [ "$1" = bright-up ]; then
            brightnessctl set 5%+ >/dev/null 2>&1
        else
            brightnessctl set 5%- >/dev/null 2>&1
        fi
        N "Brightness $(br_pct)%"
        ;;
    touchpad)
        if [ -e "$HOME/.cache/fn-touchpad-off" ]; then tp_apply on; else tp_apply off; fi
        ;;
    touchpad-on)  tp_apply on ;;
    touchpad-off) tp_apply off ;;
    airplane|wifi)
        if have nmcli; then
            if [ "$(nmcli radio wifi 2>/dev/null)" = "enabled" ]; then
                nmcli radio wifi off >/dev/null 2>&1
                N "Airplane mode ON" "Wi-Fi off"
            else
                nmcli radio wifi on >/dev/null 2>&1
                N "Airplane mode OFF" "Wi-Fi on"
            fi
        elif have rfkill; then
            if rfkill list wlan 2>/dev/null | grep -q "Soft blocked: yes"; then
                rfkill unblock wlan
                N "Airplane mode OFF" "Wi-Fi on"
            else
                rfkill block wlan
                N "Airplane mode ON" "Wi-Fi off"
            fi
        else
            N "Airplane mode" "no nmcli/rfkill"
        fi
        ;;
    display)
        exec "$HOME/.local/bin/display-switch"
        ;;
    kbd-up|kbd-down)
        if [ "$1" = kbd-up ]; then
            if kbd_ok; then brightnessctl -d '*kbd*' set 10%+ >/dev/null 2>&1; N "Keyboard backlight" "$(kbd_pct)%"; else N "Keyboard backlight" "Brightness increased"; fi
        elif [ "$1" = kbd-down ]; then
            if kbd_ok; then brightnessctl -d '*kbd*' set 10%- >/dev/null 2>&1; N "Keyboard backlight" "$(kbd_pct)%"; else N "Keyboard backlight" "Brightness decreased"; fi
        fi
        ;;
    kbd-toggle)
        if kbd_ok; then
            cur="$(brightnessctl -d '*kbd*' get 2>/dev/null)"
            if [ "${cur:-0}" -gt 0 ] 2>/dev/null; then
                brightnessctl -d '*kbd*' get > "$HOME/.cache/fn-kbd-last" 2>/dev/null
                brightnessctl -d '*kbd*' set 0 >/dev/null 2>&1
                N "Keyboard backlight off"
            else
                last="$(cat "$HOME/.cache/fn-kbd-last" 2>/dev/null || echo 1)"
                brightnessctl -d '*kbd*' set "$last" >/dev/null 2>&1
                N "Keyboard backlight on"
            fi
        else
            N "Keyboard backlight" "firmware controlled"
        fi
        ;;
    sleep)
        have systemctl && systemctl suspend || N "Sleep" "systemctl not found"
        ;;
    *)
        N "Fn key" "unknown action: ${1:-}"
        ;;
esac
exit 0

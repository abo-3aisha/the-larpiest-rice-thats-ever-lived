#!/usr/bin/env python3
import hashlib
import os
import re
import subprocess
import sys
import threading
import warnings
from collections import OrderedDict

warnings.filterwarnings("ignore", module="gi")
warnings.filterwarnings("ignore", category=DeprecationWarning)

HAS_GTK = True
try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GLib, GdkPixbuf, Gtk
except Exception:
    HAS_GTK = False

THUMB = os.path.expanduser("~/.cache/wallpaper-picker/thumbs")
CONF = os.path.expanduser("~/.config/hypr/hyprpaper.conf")
APPLY = os.path.expanduser("~/.local/bin/apply-wallpaper")
DIR = os.path.expanduser("~/Pictures/Wallpapers")
EXT = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif", ".tif", ".tiff",
       ".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v")


def natsort_key(s):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]


def list_files():
    try:
        names = os.listdir(DIR)
    except OSError:
        return []
    files = [os.path.join(DIR, n) for n in names
             if os.path.splitext(n)[1].lower() in EXT
             and os.path.isfile(os.path.join(DIR, n))]
    files.sort(key=natsort_key)
    return files


def thumb(path):
    key = hashlib.md5(os.path.abspath(path).encode()).hexdigest()[:16]
    out = os.path.join(THUMB, key + ".jpg")
    if os.path.isfile(out) and os.path.getmtime(out) >= os.path.getmtime(path):
        return out
    os.makedirs(THUMB, exist_ok=True)
    tmp = out + ".part.jpg"
    ext = os.path.splitext(path)[1].lower()
    try:
        from PIL import Image, ImageOps
        if ext in (".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v"):
            subprocess.run(
                ["ffmpeg", "-y", "-ss", "0.7", "-i", path, "-frames:v", "1",
                 "-vcodec", "mjpeg", "-q:v", "5", "-loglevel", "error", tmp],
                check=True, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL)
            img = Image.open(tmp)
        else:
            img = Image.open(path)
            img = ImageOps.exif_transpose(img)
        img.thumbnail((1600, 900))
        img.convert("RGB").save(tmp, "JPEG", quality=82)
        os.replace(tmp, out)
        return out
    except Exception:
        return None


PB_MAX = 1200
PB_CAP = 16
XOFF = -300  # the carousel sits left of center; size is untouched


class Coverflow:
    def __init__(self, files):
        self.files = files
        self.n = len(files)
        self.pos = 0.0
        self.target = 0.0
        self.ticking = False
        self._pbs = OrderedDict()
        self._pb_lock = threading.Lock()

        self.win = Gtk.Window()
        self.win.set_title("Wallpaper Picker")
        self.win.set_decorated(False)
        self.win.connect("destroy", Gtk.main_quit)
        self.win.connect("key-press-event", self.on_keypress)

        scr = self.win.get_screen()
        if scr.get_rgba_visual():
            self.win.set_visual(scr.get_rgba_visual())
            self.win.set_app_paintable(True)
        mon = scr.get_primary_monitor()
        if mon < 0:
            mon = 0
        geo = scr.get_monitor_geometry(mon)
        self.win.set_default_size(geo.width, geo.height)
        self.win.move(geo.x, geo.y)
        self.win.set_keep_above(True)

        css = Gtk.CssProvider()
        css.load_from_data(b"""
            window.wallpapers { background-color:transparent; }
            drawingarea.wallpapers { background-color:transparent; }
            label.hint {
                color:rgba(235,222,152,0.7);
                font-family:Sans;
                font-size:14px;
                padding:10px;
            }
        """)
        screen = self.win.get_screen()
        provider = Gtk.StyleContext()
        provider.add_provider_for_screen(screen, css,
                                         Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.win.get_style_context().add_class("wallpapers")

        self.da = Gtk.DrawingArea()
        self.da.get_style_context().add_class("wallpapers")
        self.da.connect("draw", self.on_draw)
        self.da.connect("button-press-event", self.on_click)
        self.da.connect("scroll-event", self.on_scroll)

        hint = Gtk.Label(label="arrows flip  ·  Enter apply  ·  Esc close")
        hint.get_style_context().add_class("hint")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(self.da, True, True, 0)
        box.pack_start(hint, False, False, 0)
        self.win.add(box)
        self.win.show_all()
        self.win.fullscreen()
        self.win.present()

        for i in range(max(0, round(self.pos) - 2),
                       min(self.n, round(self.pos) + 3)):
            self.pb(i)

    def pb(self, i):
        with self._pb_lock:
            if i in self._pbs:
                self._pbs.move_to_end(i)
                return self._pbs[i]
        t = os.path.join(THUMB,
                         hashlib.md5(os.path.abspath(self.files[i])
                                     .encode()).hexdigest()[:16] + ".jpg")
        if not os.path.isfile(t):
            t = thumb(self.files[i])
            if not t:
                with self._pb_lock:
                    self._pbs[i] = None
                return None
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_size(t, PB_MAX, PB_MAX * 9 // 16)
        except Exception:
            with self._pb_lock:
                self._pbs[i] = None
            return None
        with self._pb_lock:
            self._pbs[i] = pb
            while len(self._pbs) > PB_CAP:
                self._pbs.popitem(last=False)
        return pb

    def move(self, delta):
        self.target = max(0.0, min(self.n - 1, self.target + delta))
        if not self.ticking:
            self.ticking = True
            GLib.timeout_add(16, self.tick)

    def tick(self):
        diff = self.target - self.pos
        if abs(diff) < 0.005:
            self.pos = self.target
            self.ticking = False
            self.da.queue_draw()
            return False
        self.pos += diff * 0.22
        self.da.queue_draw()
        return True

    def current_idx(self):
        return max(0, min(self.n - 1, int(round(self.pos))))

    def round_rect(self, cr, x, y, w, h, r):
        from math import pi
        r = min(r, w / 2, h / 2)
        cr.arc(x + r, y + r, r, pi, 3 * pi / 2)
        cr.arc(x + w - r, y + r, r, 3 * pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, pi / 2)
        cr.arc(x + r, y + h - r, r, pi / 2, pi)
        cr.close_path()

    def bevel_rect(self, cr, x, y, w, h, sk):
        cr.move_to(x + sk, y)
        cr.line_to(x + w, y)
        cr.line_to(x + w - sk, y + h)
        cr.line_to(x, y + h)
        cr.close_path()

    def paint_fit(self, cr, pb, bx, by, bw, bh, radius, sel, sk=0):
        iw, ih = pb.get_width(), pb.get_height()
        s = min(bw / iw, bh / ih)
        dw, dh = iw * s, ih * s
        dx, dy = bx + (bw - dw) / 2, by + (bh - dh) / 2

        cr.save()
        if sk > 0:
            self.bevel_rect(cr, dx, dy, dw, dh, sk)
        else:
            self.round_rect(cr, dx, dy, dw, dh, radius if sel else 10)
        cr.clip()
        surface = Gdk.cairo_surface_create_from_pixbuf(pb, 1, None)
        cr.set_source_surface(surface, dx, dy)
        cr.paint()
        if not sel:
            cr.set_source_rgba(0, 0, 0, 0.42)
            cr.rectangle(dx, dy, dw, dh)
            cr.fill()
        cr.restore()

        if sel:
            if sk > 0:
                cr.save()
                cr.set_source_rgba(0, 0, 0, 0.38)
                cr.move_to(dx + sk, dy)
                cr.line_to(dx, dy)
                cr.line_to(dx, dy + dh)
                cr.close_path()
                cr.fill()
                cr.move_to(dx + dw - sk, dy + dh)
                cr.line_to(dx + dw, dy)
                cr.line_to(dx + dw, dy + dh)
                cr.close_path()
                cr.fill()
                cr.restore()
            cr.save()
            cr.set_source_rgba(1.0, 0.96, 0.42, 1.0)
            cr.set_line_width(5)
            if sk > 0:
                self.bevel_rect(cr, dx, dy, dw, dh, sk)
            else:
                self.round_rect(cr, dx - 3, dy - 3, dw + 6, dh + 6, radius + 4)
            cr.stroke()
            cr.restore()

    def wrap_d(self, i):
        d = i - self.pos
        n = self.n
        if n > 1:
            while d > n / 2:
                d -= n
            while d < -n / 2:
                d += n
        return d

    def on_draw(self, da, cr):
        from math import cos
        W = da.get_allocated_width()
        H = da.get_allocated_height()
        cr.set_source_rgba(0.03, 0.03, 0.04, 0.30)
        cr.paint()

        base_w = min(W * 0.60, 1180)
        base_h = base_w * 9 / 16
        step = min(W * 0.30, 300)
        cx = W / 2 + XOFF
        cy = H / 2 - 20

        cur = round(self.pos)
        order = sorted(range(self.n),
                       key=lambda i: -abs(i - (cur if self.ticking else round(self.pos))))
        for i in order:
            d = self.wrap_d(i)
            if abs(d) > 2.6:
                continue
            a = max(0.0, abs(d) - 0.0) * 0.45
            a = min(a, 1.15) * (1 if d >= 0 else -1)
            s = 1.0 - 0.22 * abs(d)
            if abs(d) > 1:
                s -= 0.17 * (abs(d) - 1)
            s = max(s, 0.28)
            slot_w = base_w * s
            slot_h = base_h * s
            x = cx + d * step
            y = cy - slot_h / 2

            pb = self.pb(i)
            if pb is None:
                continue

            cr.save()
            if d > 0.05:
                cr.translate(x, y + slot_h / 2)
                cr.rotate(a)
                cr.translate(-x, -(y + slot_h / 2))
            elif d < -0.05:
                cr.translate(x + slot_w, y + slot_h / 2)
                cr.rotate(a)
                cr.translate(-(x + slot_w), -(y + slot_h / 2))
            sel = abs(d) <= 0.5
            sk = (20 + 260 * abs(d)) if sel else 0
            self.paint_fit(cr, pb, x, y, slot_w, slot_h,
                           14 if sel else 8, sel, sk)
            cr.restore()
            if d == 0:
                pass
        cr.set_source_rgba(1.0, 0.2, 0.2, 0.7)
        cr.set_line_width(1.5)
        cr.move_to(cx - 18, cy)
        cr.line_to(cx + 18, cy)
        cr.stroke()
        cr.move_to(cx, cy - 18)
        cr.line_to(cx, cy + 18)
        cr.stroke()
        return False

    def on_keypress(self, win, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.win.destroy()
            return True
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter,
                         Gdk.KEY_space, Gdk.KEY_KP_Space):
            self.apply(self.files[self.current_idx()])
            return True
        if ev.keyval in (Gdk.KEY_Right, Gdk.KEY_KP_Right,
                         Gdk.KEY_Down, Gdk.KEY_KP_Down):
            self.move(1)
            return True
        if ev.keyval in (Gdk.KEY_Left, Gdk.KEY_KP_Left,
                         Gdk.KEY_Up, Gdk.KEY_KP_Up):
            self.move(-1)
            return True
        if ev.keyval == Gdk.KEY_Home:
            self.target = 0.0
            if not self.ticking:
                self.ticking = True
                GLib.timeout_add(16, self.tick)
            return True
        if ev.keyval == Gdk.KEY_End:
            self.target = float(self.n - 1)
            if not self.ticking:
                self.ticking = True
                GLib.timeout_add(16, self.tick)
            return True
        return False

    def on_scroll(self, da, ev):
        if ev.direction == Gdk.ScrollDirection.UP:
            self.move(-1)
            return True
        if ev.direction == Gdk.ScrollDirection.DOWN:
            self.move(1)
            return True
        return False

    def on_click(self, da, ev):
        W = da.get_allocated_width()
        H = da.get_allocated_height()
        base_w = min(W * 0.60, 1180)
        base_h = base_w * 9 / 16
        step = min(W * 0.30, 300)
        cx = W / 2 + XOFF
        cy = H / 2 - 20
        d = round(self.pos) - self.pos
        if self.n > 1:
            while d > self.n / 2:
                d -= self.n
            while d < -self.n / 2:
                d += self.n
        x = cx + d * step
        y = cy - base_h / 2
        if x <= ev.x <= x + base_w and y <= ev.y <= y + base_h:
            self.apply(self.files[self.current_idx()])
            return True
        return False

    def apply(self, path):
        if path:
            with open(CONF, "w") as f:
                f.write("preload = %s\nwallpaper = eDP-1,%s\n" % (path, path))
            subprocess.Popen(
                [APPLY], start_new_session=True,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                cwd=os.path.expanduser("~"))
        self.win.destroy()


def selftest(argv):
    files = list_files()
    ok = bad = 0
    for f in files:
        if thumb(f):
            ok += 1
        else:
            bad += 1
    print("selftest: %d files, thumbs ok=%d bad=%d, cache=%s"
          % (len(files), ok, bad, THUMB))


def main(argv):
    if "--selftest" in argv:
        selftest(argv)
        return 0
    if not HAS_GTK:
        msg = ("wallpaper picker needs GTK3 python bindings.\n"
               "install once:  sudo pacman -S python-gobject")
        print(msg)
        subprocess.run(["notify-send", "-t", "6000", "Wallpaper Picker", msg])
        return 1
    files = list_files()
    if not files:
        subprocess.run(["notify-send", "-t", "4000", "Wallpaper",
                        "no wallpapers in %s" % DIR])
        return 0
    try:
        Coverflow(files)
        Gtk.main()
    except Exception:
        import traceback
        tb = traceback.format_exc()
        try:
            with open(os.path.join(os.path.expanduser("~/.cache/wallpaper-picker"),
                                   "error.log"), "w") as f:
                f.write(tb)
        except OSError:
            pass
        print(tb)
        subprocess.run(["notify-send", "-t", "8000", "Wallpaper Picker",
                        "error: " + tb.splitlines()[-1][:500]])
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": ["custom/logo", "hyprland/workspaces", "custom/comm-layer", "hyprland/language"],
    "modules-center": ["custom/weather", "custom/net-speed", "clock"],
    "modules-right": ["tray", "custom/wifi", "pulseaudio", "custom/battery", "custom/power"],

    "custom/logo": {
        "format": "\uf303 ",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "show-special": false
    },

    "custom/comm-layer": {
        "exec": "/home/abo3aisha/.local/bin/comm-layer-waybar.sh",
        "return-type": "json",
        "interval": 1,
        "tooltip": false
    },

    "hyprland/language": {
        "format": "{}",
        "tooltip": false
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "/home/abo3aisha/.local/bin/nowtoggle"
    },

    "tray": {
        "spacing": 8
    },

    "custom/weather": {
        "exec": "/home/abo3aisha/.local/bin/weather-waybar.sh",
        "interval": 600,
        "return-type": "json",
        "on-click": "/home/abo3aisha/.local/bin/weather-waybar.sh --detail"
    },

    "custom/net-speed": {
        "exec": "/home/abo3aisha/.local/bin/net-speed-waybar.sh",
        "interval": 1,
        "return-type": "json",
        "tooltip": true
    },

    "custom/wifi": {
        "exec": "/home/abo3aisha/.local/bin/wifi-waybar.sh",
        "interval": 10,
        "return-type": "json",
        "signal": 1,
        "on-click": "/home/abo3aisha/.local/bin/wifi-center"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "/home/abo3aisha/.local/bin/vol-bar.py"
    },

    "custom/battery": {
        "exec": "/home/abo3aisha/.local/bin/battery-bar.sh",
        "interval": 10,
        "return-type": "json",
        "on-click": "/home/abo3aisha/.local/bin/power-menu",
        "on-scroll": "/home/abo3aisha/.local/bin/cycle-power"
     },

     "custom/power": {
        "format": "\uf011 ",
        "tooltip": false,
        "on-click": "/home/abo3aisha/.local/bin/session-menu"
    }

}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "S",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "R",
    "keybind" : "r"
}
{
    "label" : "logout",
    "action" : "loginctl terminate-session \"$XDG_SESSION_ID\" || pkill -x Hyprland",
    "text" : "L",
    "keybind" : "l"
}
